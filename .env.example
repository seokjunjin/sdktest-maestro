# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣으세요. .env 는 커밋되지 않습니다.
# scripts/run.sh 가 .env 를 읽어서 Maestro 에 -e 옵션으로 전달합니다.
# 다만 MAESTRO_ 로 시작하는 항목은 플로우 변수가 아니라 Maestro CLI 자체의 설정이므로,
# -e 로 넘기지 않고 프로세스 환경 변수로 내보냅니다.

# 테스트 대상 앱의 패키지 이름 또는 번들 식별자
APP_ID=com.example.sdktest

# SDK 테스트에 사용할 계정 정보 (필요한 경우에만 채우세요)
TEST_ACCOUNT_ID=
TEST_ACCOUNT_PW=

# 대상 환경 구분값 (dev, qa, live 중 하나)
SDK_ENV=qa

# Unity 로 렌더링되는 화면(SDK Configuration, 로비)의 내용을 assertWithAI 로 검증할지
# 여부입니다. 이 화면들은 뷰 계층에 문구가 노출되지 않아서 다른 방법으로는 검증할 수 없습니다.
# true 로 켜려면 아래 MAESTRO_CLOUD_API_KEY 도 함께 설정해야 합니다.
#
# 주의: assertWithAI 는 판정을 위해 화면 스크린샷을 Maestro Cloud 로 전송합니다.
# SDK Configuration 화면에는 SDK APIKey 가, 로비 화면에는 내부 게임 엔드포인트가 함께
# 찍히므로, 그 내용이 외부 서비스로 전달되는 것을 확인한 뒤에 켜 주세요.
AI_ASSERT=false

# 위 AI_ASSERT 를 켰을 때 필요한 Maestro Cloud API 키입니다.
# `maestro login` 으로 발급받거나 Maestro Cloud 콘솔에서 확인할 수 있습니다.
MAESTRO_CLOUD_API_KEY=
