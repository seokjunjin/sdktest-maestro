# 로컬 환경 변수 (계정 정보와 내부 패키지 이름이 담기므로 절대 커밋하지 않는다)
.env
.env.local

# Maestro 실행 산출물
.maestro/output/
maestro-report.*
*.mp4
screenshots/

# scripts/run.sh 가 실행마다 만드는 결과 폴더 (JUnit 결과, 로그, 스크린샷)
reports/

# 파이썬 스크립트를 실행할 때 생기는 바이트코드 캐시
__pycache__/

# 테스트용 앱 바이너리
*.apk
*.aab
*.app
*.ipa
builds/

# macOS
.DS_Store

# 에디터 설정
.idea/
.vscode/

# Claude Code 개인 설정 (.claude/settings.json 은 공유하므로 제외하지 않는다)
.claude/settings.local.json
